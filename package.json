{
  "name": "frontend_vers1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src scripts tests *.js",
    "format": "prettier --write src scripts tests *.js *.json index.html README.md",
    "format:check": "prettier --check src scripts tests *.js *.json index.html README.md",
    "test:ui": "playwright test",
    "test:smoke": "playwright test --grep \"customer|staff|cashier|order\"",
    "test:languages": "playwright test --grep \"language\""
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.18.1",
    "jsqr": "^1.4.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.1.1"
  }
}
